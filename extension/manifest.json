{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.8.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "debugger",
    "alarms",
    "notifications",
    "tabGroups",
    "contextMenus"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    },
    "ask-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Ask Mezze about the selection"
    },
    "summarise-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Summarise this page with Mezze"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
